      "isDeleted": false,
      "boundElements": [],
      "updated": 1778171604894,
      "link": null,
      "locked": false,
      "text": "int f(int A[], int n)\n{\n    if(n == 1) return A[0];\n\n    int smallAns = f(A, n - 1);\n    \n    int ans = min(smallAns, A[n - 1]);\n    return ans; \n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(int A[], int n)\n{\n    if(n == 1) return A[0];\n\n    int smallAns = f(A, n - 1);\n    \n    int ans = min(smallAns, A[n - 1]);\n    return ans; \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
