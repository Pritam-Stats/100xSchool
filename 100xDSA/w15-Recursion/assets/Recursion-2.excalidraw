      "text": "void f(int A[], int n)\n{\n    if(n == 0) return;   \n    cout << A[n - 1] << endl;\n    f(A, n - 1); \n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void f(int A[], int n)\n{\n    if(n == 0) return;   \n    cout << A[n - 1] << endl;\n    f(A, n - 1); \n}",
