      "text": "main()\n{\n    int n;\n    cin >> n;\n    \n    int A[n];\n    for(int i = 0; i < n; i++)\n    {\n        cin >> A[i];\n    }\n\n    f(A, n); // must be recursive, to print the array in reverse order\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main()\n{\n    int n;\n    cin >> n;\n    \n    int A[n];\n    for(int i = 0; i < n; i++)\n    {\n        cin >> A[i];\n    }\n\n    f(A, n); // must be recursive, to print the array in reverse order\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
