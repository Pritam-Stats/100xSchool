    {
      "id": "JVGhH3srAINrGUrJpaqW9",
      "type": "text",
      "x": 2988.427270784392,
      "y": 51.00599225533233,
      "width": 954.7996826171875,
      "height": 455,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2c",
      "roundness": null,
      "seed": 1196800071,
      "version": 302,
      "versionNonce": 1558167913,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778171604895,
      "link": null,
      "locked": false,
      "text": "// Array A of size n -> find first occ of x in array of size n\nint f(int A[], int n, int x)\n{\n    if(n == 0) return -1;\n\n    int smallAns = f(A, n - 1, x);\n    \n    if(smallAns != -1) return smallAns;\n\n    if(A[n - 1] == x) return n - 1;\n    \n     return -1;\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Array A of size n -> find first occ of x in array of size n\nint f(int A[], int n, int x)\n{\n    if(n == 0) return -1;\n\n    int smallAns = f(A, n - 1, x);\n    \n    if(smallAns != -1) return smallAns;\n\n    if(A[n - 1] == x) return n - 1;\n    \n     return -1;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
