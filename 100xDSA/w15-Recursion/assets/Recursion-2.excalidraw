      "link": null,
      "locked": false,
      "text": "int f(int A[], int n)\n{\n    if(n == 0) return INT_MAX;\n\n    int smallAns = f(A, n - 1);\n    \n    int ans = min(smallAns, A[n - 1]);\n    return ans; \n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(int A[], int n)\n{\n    if(n == 0) return INT_MAX;\n\n    int smallAns = f(A, n - 1);\n    \n    int ans = min(smallAns, A[n - 1]);\n    return ans; \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
