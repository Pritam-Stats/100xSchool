      "updated": 1778171604894,
      "link": null,
      "locked": false,
      "text": "main()\n{\n    int n;\n    cin >> n;\n    \n    int A[n];\n    for(int i = 0; i < n; i++)\n    {\n        cin >> A[i];\n    }\n\n    cout << f(A, n) << endl; \n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main()\n{\n    int n;\n    cin >> n;\n    \n    int A[n];\n    for(int i = 0; i < n; i++)\n    {\n        cin >> A[i];\n    }\n\n    cout << f(A, n) << endl; \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NIaO9-s3kFWCUmTbLRjmg",
      "type": "text",
      "x": -747.2496177975554,
