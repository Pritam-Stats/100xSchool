      "updated": 1778171604894,
      "link": null,
      "locked": false,
      "text": "// Array A of size n -> print the array elements in order\nvoid f(int A[], int n)\n{\n    if(n == 0) return;\n    f(A, n - 1);\n    cout << A[n - 1] << endl;\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Array A of size n -> print the array elements in order\nvoid f(int A[], int n)\n{\n    if(n == 0) return;\n    f(A, n - 1);\n    cout << A[n - 1] << endl;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
