      "isDeleted": false,
      "boundElements": [],
      "updated": 1778171604895,
      "link": null,
      "locked": false,
      "text": "void f(int A[], int n, int x)\n{\n    if(n == 0) return -1;    \n\n    f(A, n - 1, x); // all occurences of x in the ans\n\n    if(A[n - 1] == x)\n    {\n        ans.push_back(n - 1);\n    }\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void f(int A[], int n, int x)\n{\n    if(n == 0) return -1;    \n\n    f(A, n - 1, x); // all occurences of x in the ans\n\n    if(A[n - 1] == x)\n    {\n        ans.push_back(n - 1);\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
