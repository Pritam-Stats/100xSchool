      "updated": 1778171604895,
      "link": null,
      "locked": false,
      "text": "bool f(int A[], int n)\n{\n    if(n == 1) return true;    \n\n    bool smallAns = f(A, n - 1);\n    \n    if(smallAns == false) return false;\n\n    return A[n - 1] >= A[n - 2];\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool f(int A[], int n)\n{\n    if(n == 1) return true;    \n\n    bool smallAns = f(A, n - 1);\n    \n    if(smallAns == false) return false;\n\n    return A[n - 1] >= A[n - 2];\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
